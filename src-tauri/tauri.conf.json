{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Configurador Aula",
  "version": "0.1.0",
  "identifier": "io.github.nadsuus.aula-configurador",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Configurador Aula HERO",
        "width": 1400,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "nadsuus",
    "shortDescription": "Configurador para teclados Aula HERO",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
